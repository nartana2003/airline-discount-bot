.env

# Personal Claude Code permissions - local to one machine, not project config.
.claude/settings.local.json

# state.json is deliberately NOT ignored: the scheduled workflow commits it
# back after each run, and that commit is what gives the bot its memory
# (alert cooldowns + monthly search count) between runs.
state.demo.json

# prices.jsonl is deliberately NOT ignored: it is the accumulating price
# record, and the workflow commits it back after each run. The demo one is
# invented fixture data and must never mix into it.
prices.demo.jsonl
__pycache__/
*.pyc
.venv/
venv/

# Local preview of the email, generated by hand - not part of the bot.
email-preview.html
digest-preview.html
