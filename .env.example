# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Flight price data (https://serpapi.com/manage-api-key) ---
# Free tier: 250 searches/month. Each date-window chunk costs 1 search.
SERPAPI_KEY=

# --- Email alerts (Gmail) ---
# Use a Google App Password, NOT your normal account password.
# Requires 2-Step Verification on, then: myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
ALERT_TO=you@gmail.com
